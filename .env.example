# ==============================================================================
# Flight Scanner Environment Configuration
# ==============================================================================

# Telegram Bot Credentials
# Obtain bot token from @BotFather, and chat_id from @userinfobot or channel ID
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
CHAT_ID=123456789

# Price Threshold in specified currency (offers strictly <= this price will trigger alerts)
PRICE_THRESHOLD=500.0
CURRENCY=PLN

# Target API endpoint URL providing flight/charter offers
API_ENDPOINT_URL=https://api.example.com/charter-flights

# HTTP Client Tuning
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.0

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
